{
  "manifest_version": 3,
  "key": "",
  "name": "ImmerseFree",
  "version": "0.8.0",
  "description": "Bilingual translation for web pages, video subtitles, EPUB and PDF books, selected text and hovered paragraphs.",
  "version_name": "0.8.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://opencode.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "ImmerseFree",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "ui/options.html",
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "翻譯目前網頁"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "MacCtrl+Shift+T"
      },
      "description": "翻譯選取文字"
    },
    "toggle-ai-subtitle": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "開關 AI 字幕"
    },
    "toggle-dual-subtitle": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "開關雙軌字幕"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core/i18n-core.js",
        "core/diagnostics-core.js",
        "core/page-translation-ui.js",
        "core/page-translation-cache.js",
        "core/language-core.js",
        "core/shared.js",
        "core/batch-core.js",
        "core/subtitle-linebreak-core.js",
        "core/subtitle-merge-core.js",
        "core/video-subtitle-core.js",
        "core/youtube-subtitle-core.js",
        "core/subtitle-retry-core.js",
        "core/streaming-subtitle-core.js",
        "core/subtitle-format-core.js",
        "core/subtitle-store-core.js",
        "core/glossary-core.js",
        "core/subtitle-glossary-core.js",
        "core/subtitle-context-core.js",
        "core/manifest-core.js",
        "core/rich-text-core.js",
        "core/segmentation-core.js",
        "core/site-rules-core.js",
        "core/player-context-core.js",
        "content/page-translator.js",
        "content/subtitle-translator.js",
        "content/interaction-translator.js",
        "content/dual-subtitle.js",
        "content/floating-ball.js",
        "content/main.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/sniffer-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/youtube-page-bridge.js",
        "content/track-sniffer.js",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "core/site-rules.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
